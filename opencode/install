#!/usr/bin/env bash
set -euo pipefail
APP=rift
BIN=rift          # binary name inside the archive; becomes rift.exe on Windows
ALIAS=opencode    # second command name, so either one starts it
# GitHub's download host answers from several addresses in rotation, and from some networks one
# of them accepts no connections. A bare curl waits out its full default connect timeout on that
# address, about a minute of silence before trying the next, and which address comes first is
# random, so an install works one day and looks hung the next. Capping the connect phase makes
# curl split that budget across the addresses, so a dead one costs seconds. Measured with the dead
# address forced first: 60s bare, 5s with 10. A retry covers the rare case where it still fails.
curl() {
    command curl --connect-timeout 10 --retry 2 --retry-delay 1 "$@"
}

os=""             # stays empty on the --binary path, which skips platform detection
reload_file=""    # shell config that now has rift on PATH, which an already-open terminal has not read
linked_dir=""     # PATH directory rift was linked into, which makes a shell-config edit unnecessary

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
RIFT Installer

Usage: install [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 1.0.180)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't touch your shell config (.zshrc, .bashrc, etc.) or link into your PATH

Examples:
    curl -fsSL https://raw.githubusercontent.com/Datum-Collective/RIFT-coding-agent/main/opencode/install | bash
    curl -fsSL https://raw.githubusercontent.com/Datum-Collective/RIFT-coding-agent/main/opencode/install | bash -s -- --version 1.0.0
    ./install --binary /path/to/rift
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

INSTALL_DIR=${RIFT_INSTALL_DIR:-$HOME/.rift/bin}
mkdir -p "$INSTALL_DIR"

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    if [ "$os" = "windows" ]; then
      BIN=rift.exe
    fi

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64|windows-arm64)
        ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    archive_ext=".zip"
    if [ "$os" = "linux" ]; then
      archive_ext=".tar.gz"
    fi

    is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi

      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        if ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "windows" ]; then
        ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
        out=""
        if command -v powershell.exe >/dev/null 2>&1; then
          out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        elif command -v pwsh >/dev/null 2>&1; then
          out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        fi
        out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [ "$out" != "true" ] && [ "$out" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    filename="$APP-$target$archive_ext"


    if [ "$os" = "linux" ]; then
        if ! command -v tar >/dev/null 2>&1; then
             echo -e "${RED}Error: 'tar' is required but not installed.${NC}"
             exit 1
        fi
    else
        if ! command -v unzip >/dev/null 2>&1; then
            echo -e "${RED}Error: 'unzip' is required but not installed.${NC}"
            exit 1
        fi
    fi

    if [ -z "$requested_version" ]; then
        url="https://github.com/Datum-Collective/RIFT-coding-agent/releases/latest/download/$filename"
        specific_version=$(curl -s https://api.github.com/repos/Datum-Collective/RIFT-coding-agent/releases/latest | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')

        if [[ $? -ne 0 || -z "$specific_version" ]]; then
            echo -e "${RED}Failed to fetch version information${NC}"
            exit 1
        fi
    else
        # Strip leading 'v' if present
        requested_version="${requested_version#v}"
        url="https://github.com/Datum-Collective/RIFT-coding-agent/releases/download/v${requested_version}/$filename"
        specific_version=$requested_version

        # Verify the release exists before downloading
        http_status=$(curl -sI -o /dev/null -w "%{http_code}" "https://github.com/Datum-Collective/RIFT-coding-agent/releases/tag/v${requested_version}")
        if [ "$http_status" = "404" ]; then
            echo -e "${RED}Error: Release v${requested_version} not found${NC}"
            echo -e "${MUTED}Available releases: https://github.com/Datum-Collective/RIFT-coding-agent/releases${NC}"
            exit 1
        fi
    fi
fi

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

check_version() {
    if command -v rift >/dev/null 2>&1; then

        ## Check the installed version
        installed_version=$(rift --version 2>/dev/null || echo "")

        if [[ "$installed_version" != "$specific_version" ]]; then
            print_message info "${MUTED}Installed version: ${NC}$installed_version."
        else
            print_message info "${MUTED}Version ${NC}$specific_version${MUTED} already installed"
            exit 0
        fi
    fi
}

unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad
    pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled
    filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty
    empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    local tmp_dir=${TMPDIR:-/tmp}
    local basename="${tmp_dir}/rift_install_$$"
    local tracefile="${basename}.trace"

    rm -f "$tracefile"
    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    # shellcheck disable=SC2064
    trap "trap - RETURN; rm -f \"$tracefile\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    (
        curl --trace-ascii "$tracefile" -f -s -L -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done
    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

download_and_install() {
    print_message info "\n${MUTED}Installing ${NC}rift ${MUTED}version: ${NC}$specific_version"
    # The progress bar cannot draw until the connection is up, so say what is happening first.
    # Without this the terminal shows one line and then nothing, which reads as a hang.
    print_message info "${MUTED}Downloading ${NC}${filename}${MUTED} ...${NC}"
    local tmp_dir="${TMPDIR:-/tmp}/rift_install_$$"
    mkdir -p "$tmp_dir"

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$tmp_dir/$filename"; then
        # Fallback to standard curl on Windows, non-TTY environments, or if custom progress fails
        if ! curl -fL# -o "$tmp_dir/$filename" "$url"; then
            rm -rf "$tmp_dir"
            # Without -f the error page was saved as the archive and unzip failed with a message
            # about zip directories, which said nothing about the real problem.
            print_message error "\nError: could not download RIFT ${specific_version} for ${target}."
            echo -e "${MUTED}Tried: ${NC}$url"
            echo -e "${MUTED}That release may not have a build for this platform yet, or the release may still be publishing.${NC}"
            echo -e "${MUTED}Available releases: ${NC}https://github.com/Datum-Collective/RIFT-coding-agent/releases"
            exit 1
        fi
    fi

    if [ "$os" = "linux" ]; then
        tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
    else
        unzip -q "$tmp_dir/$filename" -d "$tmp_dir"
    fi

    mv "$tmp_dir/$BIN" "$INSTALL_DIR"
    chmod 755 "${INSTALL_DIR}/${BIN}"
    rm -rf "$tmp_dir"
    link_alias
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}rift ${MUTED}from: ${NC}$binary_path"
    cp "$binary_path" "${INSTALL_DIR}/${BIN}"
    chmod 755 "${INSTALL_DIR}/${BIN}"
    link_alias
}

# Both `rift` and `opencode` start the app. A relative symlink keeps the directory movable and
# costs nothing; copying a 103MB binary twice would not be acceptable. Windows has no usable
# symlink without admin rights, so it gets a tiny forwarding script instead.
link_alias() {
    if [ "$os" = "windows" ]; then
        # Git Bash: a shell script, not a PE binary, so it keeps the bare name.
        printf '#!/bin/sh\nexec "%s/%s" "$@"\n' "$INSTALL_DIR" "$BIN" > "${INSTALL_DIR}/${ALIAS}"
        chmod 755 "${INSTALL_DIR}/${ALIAS}"
    else
        ln -sf "$BIN" "${INSTALL_DIR}/${ALIAS}"
    fi
}

# A script cannot change the PATH of the shell that launched it. Editing a shell config therefore
# only takes effect in terminals opened afterwards, and the terminal the installer ran in keeps
# saying "command not found" until it is reloaded. Linking into a directory that is already on PATH
# works at once, in every terminal, which is why it is tried first.
#
# Only conventional user-command directories are used, only when they are already on PATH and
# writable (so no sudo), and nothing is ever overwritten or shadowed: a command of the same name
# found anywhere on PATH, such as another tool's `opencode`, is left alone.
link_into_path() {
    local dir="" candidate name target link existing

    case ":$PATH:" in
        *":$INSTALL_DIR:"*) return 0 ;;
    esac

    for candidate in "$HOME/.local/bin" "$HOME/bin" "/opt/homebrew/bin" "/usr/local/bin"; do
        case ":$PATH:" in
            *":$candidate:"*) ;;
            *) continue ;;
        esac
        if [ -d "$candidate" ] && [ -w "$candidate" ]; then
            dir=$candidate
            break
        fi
    done
    [ -n "$dir" ] || return 0

    for name in rift opencode; do
        target="$INSTALL_DIR/$name"
        link="$dir/$name"
        [ -e "$target" ] || continue

        if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
            # Already ours, from an earlier install.
            if [ "$name" = "rift" ]; then linked_dir=$dir; fi
            continue
        fi

        existing=$(command -v "$name" 2>/dev/null || true)
        if [ -n "$existing" ] || [ -e "$link" ] || [ -L "$link" ]; then
            print_message info "${MUTED}Left ${NC}${name}${MUTED} alone, ${NC}${existing:-$link}${MUTED} already exists.${NC}"
            continue
        fi

        if ln -s "$target" "$link" 2>/dev/null; then
            if [ "$name" = "rift" ]; then linked_dir=$dir; fi
            print_message info "${MUTED}Linked ${NC}${name}${MUTED} into ${NC}${dir}${MUTED}, already on your PATH.${NC}"
        fi
    done
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi


add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
        reload_file=$config_file
    elif [[ -w $config_file ]]; then
        echo -e "\n# rift" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}Successfully added ${NC}rift ${MUTED}to \$PATH in ${NC}$config_file"
        reload_file=$config_file
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" && "$os" != "windows" ]]; then
    link_into_path
fi

if [[ "$no_modify_path" != "true" && -z "$linked_dir" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            ash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "Manually add the directory to $config_file (or similar):"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> $GITHUB_PATH
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

echo -e ""
echo -e "${MUTED}         ${NC}    ▄    "
echo -e "${MUTED}█▀▀█ ▀██▀${NC} █▀▀▀ ████"
echo -e "${MUTED}█▀▀▄  ██ ${NC} █▀▀   ██ "
echo -e "${MUTED}▀  ▀ ▀██▀${NC} ▀     ██ "
echo -e ""
echo -e ""
# A running shell only reads its config at startup, so the terminal this was run in cannot see the
# PATH change until it is reloaded. Without saying so, a working install looks like a broken one:
# the next thing anyone types is `rift`, and the answer is "command not found".
if [ -n "$reload_file" ]; then
    # Show ~/.zshrc rather than the absolute path, so the line reads the way people expect. A case
    # statement instead of ${var/#$HOME/~}, whose tilde handling differs between bash versions and
    # macOS still ships 3.2.
    tilde='~'
    reload_display=$reload_file
    case $reload_file in
        "$HOME"/*) reload_display="${tilde}/${reload_file#"$HOME"/}" ;;
    esac
    echo -e "${MUTED}First, load rift into this terminal (or just open a new one):${NC}"
    echo -e ""
    echo -e "source ${reload_display}"
    echo -e ""
    echo -e ""
fi
echo -e "${MUTED}RIFT includes free models, to start:${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open directory${NC}"
echo -e "rift          ${MUTED}# Run command${NC}"
echo -e ""
echo -e "${MUTED}For more information visit ${NC}https://github.com/Datum-Collective/RIFT-coding-agent"
echo -e ""
echo -e ""
