{"nodes": [{"id": "llm_design_ai_package", "label": "@opencode-ai/ai (proposed)", "file_type": "rationale", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed clean-break replacement for @opencode-ai/llm. Progressive disclosure (run a model -> control one turn -> customize execution -> author providers) keeps simple calls simple while letting advanced callers inspect/replace every stage; portable serializable Request data is kept separate from process-local execution behavior (Model, hooks) so durable runtimes can persist requests without persisting executable state."}, {"id": "llm_design_provider_definition", "label": "Provider Definition", "file_type": "rationale", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An immutable, declarative, experimental provider-authoring value; importing a provider does not register it globally, avoiding hidden global state."}, {"id": "llm_design_model", "label": "Model (design)", "file_type": "rationale", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hides the current public Route composite (protocol/endpoint/auth/transport/hooks) behind one executable value so normal users never need to learn Route directly."}, {"id": "llm_design_request", "label": "Request (design)", "file_type": "concept", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_design_provider_turn", "label": "Provider Turn", "file_type": "rationale", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserved as an explicit primitive (generateTurn/streamTurn) distinct from a complete Model Run because durable agent runtimes like OpenCode must own persistence, tool settlement, and continuation themselves rather than have the library auto-loop."}, {"id": "llm_design_model_run", "label": "Model Run", "file_type": "rationale", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "generate/stream mean a complete run (one or more provider turns with automatic local tool dispatch) by default so a useful model call requires very little code; default stop condition is turnCount(20), matching the Vercel AI SDK ToolLoopAgent default, and hitting it is a successful max-turns result, not a failure."}, {"id": "llm_design_generateresult", "label": "GenerateResult", "file_type": "concept", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_design_protocol", "label": "Protocol (design)", "file_type": "concept", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_design_stopwhen", "label": "StopWhen", "file_type": "concept", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "llm_design_hooks", "label": "Hooks (staged)", "file_type": "rationale", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five stable stages (request, body, transport, event, error) are Effectful and may transform or fail but may never secretly short-circuit execution, synthesize a response, retry, or redirect control flow, keeping hook composition (definition -> model -> call) predictable."}, {"id": "llm_design_models_dev_catalog", "label": "models.dev Catalog", "file_type": "concept", "source_file": "packages/llm/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "llm_design_ai_package", "target": "llm_readme_opencode_ai_llm", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/llm/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "llm_design_protocol", "target": "llm_src_route_protocol_protocol", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "packages/llm/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "llm_design_ai_package", "target": "llm_example_call_sites_route_provider_design", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "packages/llm/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "llm_design_model", "target": "llm_example_call_sites_provider_facade", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "packages/llm/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "llm_design_provider_turn", "target": "llm_design_model_run", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/llm/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "llm_design_ai_package", "target": "llm_design_hooks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/llm/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "llm_design_ai_package", "target": "llm_design_models_dev_catalog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/llm/DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "llm_design_ai_package", "