{"nodes": [{"id": "http_recorder_readme_httprecorder", "label": "HttpRecorder", "file_type": "concept", "source_file": "packages/http-recorder/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "http_recorder_readme_cassette", "label": "Cassette", "file_type": "concept", "source_file": "packages/http-recorder/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "http_recorder_readme_redaction", "label": "Redaction", "file_type": "rationale", "source_file": "packages/http-recorder/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secure defaults strip most headers and redact common credentials before writing; the recorder scans the whole cassette for credential-like values and refuses to write unsafe cassettes. Redaction is defense in depth, not a substitute for reviewing cassette diffs before committing."}, {"id": "http_recorder_readme_matching_and_ordering", "label": "Matching And Ordering", "file_type": "rationale", "source_file": "packages/http-recorder/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replay walks the cassette in strict record order (Nth request served by Nth interaction) so repeated identical requests with changing responses (retries, polling, cache tests) are modeled correctly; concurrent requests are recorded in request-start order even if responses complete out of order."}, {"id": "http_recorder_readme_scriptedresponses", "label": "scriptedResponses (test/lib/http.ts)", "file_type": "code", "source_file": "packages/http-recorder/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "http_recorder_readme_httprecorder", "target": "http_recorder_readme_cassette", "rel