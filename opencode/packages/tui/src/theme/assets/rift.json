{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "fgDark": "#EDEBE5",
    "mutedDark": "#A39F96",
    "faintDark": "#5E5A53",
    "accentDark": "#7C83FF",
    "accentSoftDark": "#A9AEFF",
    "panelDark": "#22211E",
    "elementDark": "#2D2B27",
    "greenDark": "#86C795",
    "amberDark": "#E2B56E",
    "redDark": "#E8806F",
    "cyanDark": "#86C3D3",
    "fgLight": "#2A2824",
    "mutedLight": "#6F6B63",
    "faintLight": "#A8A398",
    "accentLight": "#4349E0",
    "accentSoftLight": "#5A60E6",
    "panelLight": "#F2F0E8",
    "elementLight": "#E8E5DA",
    "greenLight": "#2F7D4A",
    "amberLight": "#93650E",
