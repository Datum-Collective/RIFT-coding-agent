      "dark": "mutedDark",
      "light": "mutedLight"
    },
    "markdownListEnumeration": {
      "dark": "mutedDark",
      "light": "mutedLight"
    },
    "markdownImage": {
      "dark": "accentDark",
      "light": "accentLight"
    },
    "markdownImageText": {
      "dark": "mutedDark",
      "light": "mutedLight"
    },
    "markdownCodeBlock": {
      "dark": "fgDark",
      "light": "fgLight"
    },
    "syntaxComment": {
      "dark": "#6E6A62",
      "light": "#8A857B"
    },
    "syntaxKeyword": {
      "dark": "#AFB3FF",
      "light": "#4B50D0"
    },
    "syntaxFunction": {
      "dark": "fgDark",
      "light": "fgLight"
    },
    "syntaxVariable": {
      "dark": "fgDark",
      "light": "fgLight"
    },
    "syntaxString": {
      "dark": "#A8CF9E",
      "light": "#3D7A3A"
    },
    "syntaxNumber": {
      "dark": "amberDark",
      "light": "amberLight"
    },
