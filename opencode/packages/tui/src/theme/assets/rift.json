{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "fgDark": "#E4E5E9",
    "mutedDark": "#8B909A",
    "faintDark": "#3B3E45",
    "accentDark": "#7C83FF",
    "accentSoftDark": "#A9AEFF",
    "panelDark": "#16171C",
    "elementDark": "#24262D",
    "greenDark": "#6CCB8B",
    "amberDark": "#E5B567",
    "redDark": "#F07178",
    "cyanDark": "#7FC8D9",
    "fgLight": "#1F2328",
    "mutedLight": "#656D76",
    "faintLight": "#D0D7DE",
    "accentLight": "#3D46F2",
    "accentSoftLight": "#5A62E0",
    "panelLight": "#F6F8FA",
    "elementLight": "#EAEEF2",
    "greenLight": "#1A7F37",
    "amberLight": "#9A6700",
    "redLight": "#CF222E",
    "cyanLight": "#0E7490"
  },
  "theme": {
    "primary": { "dark": "accentDark", "light": "accentLight" },
    "secondary": { "dark": "accentSoftDark", "light": "accentSoftLight" },
    "accent": { "dark": "accentDark", "light": "accentLight" },
    "error": { "dark": "redDark", "light": "redLight" },
    "warning": { "dark": "amberDark", "light": "amberLight" },
    "success": { "dark": "greenDark", "light": "greenLight" },
    "info": { "dark": "accentDark", "light": "accentLight" },
    "text": { "dark": "fgDark", "light": "fgLight" },
    "textMuted": { "dark": "mutedDark", "light": "mutedLight" },
    "selectedListItemText": { "dark": "fgDark", "light": "fgLight" },
    "background": "none",
    "backgroundPanel": { "dark": "panelDark", "light": "panelLight" },
    "backgroundElement": { "dark": "elementDark", "light": "elementLight" },
    "backgroundMenu": { "dark": "panelDark", "light": "panelLight" },
    "border": { "dark": "faintDark", "light": "faintLight" },
    "borderActive": { "dark": "accentDark", "light": "accentLight" },
    "borderSubtle": { "dark": "faintDark", "light": "faintLight" },
    "diffAdded": { "dark": "greenDark", "light": "greenLight" },
    "diffRemoved": { "dark": "redDark", "light": "redLight" },
    "diffContext": { "dark": "mutedDark", "light": "mutedLight" },
    "diffHunkHeader": { "dark": "faintDark", "light": "faintLight" },
    "diffHighlightAdded": { "dark": "greenDark", "light": "greenLight" },
    "diffHighlightRemoved": { "dark": "redDark", "light": "redLight" },
    "diffAddedBg": { "dark": "#17271D", "light": "#E6FFEC" },
    "diffRemovedBg": { "dark": "#2C171A", "light": "#FFEBE9" },
    "diffContextBg": "none",
    "diffLineNumber": { "dark": "faintDark", "light": "faintLight" },
    "diffAddedLineNumberBg": { "dark": "#17271D", "light": "#E6FFEC" },
    "diffRemovedLineNumberBg": { "dark": "#2C171A", "light": "#FFEBE9" },
    "markdownText": { "dark": "fgDark", "light": "fgLight" },
    "markdownHeading": { "dark": "fgDark", "light": "fgLight" },
    "markdownLink": { "dark": "accentDark", "light": "accentLight" },
    "markdownLinkText": { "dark": "accentSoftDark", "light": "accentSoftLight" },
    "markdownCode": { "dark": "accentSoftDark", "light": "accentSoftLight" },
    "markdownBlockQuote": { "dark": "mutedDark", "light": "mutedLight" },
    "markdownEmph": { "dark": "fgDark", "light": "fgLight" },
    "markdownStrong": { "dark": "fgDark", "light": "fgLight" },
    "markdownHorizontalRule": { "dark": "faintDark", "light": "faintLight" },
    "markdownListItem": { "dark": "mutedDark", "light": "mutedLight" },
    "markdownListEnumeration": { "dark": "mutedDark", "light": "mutedLight" },
    "markdownImage": { "dark": "accentDark", "light": "accentLight" },
    "markdownImageText": { "dark": "mutedDark", "light": "mutedLight" },
    "markdownCodeBlock": { "dark": "fgDark", "light": "fgLight" },
    "syntaxComment": { "dark": "#6B7079", "light": "#6E7781" },
    "syntaxKeyword": { "dark": "#A9AEFF", "light": "#4B53D6" },
    "syntaxFunction": { "dark": "fgDark", "light": "fgLight" },
    "syntaxVariable": { "dark": "fgDark", "light": "fgLight" },
    "syntaxString": { "dark": "#9FD0A7", "light": "#1A7F37" },
    "syntaxNumber": { "dark": "amberDark", "light": "amberLight" },
    "syntaxType": { "dark": "cyanDark", "light": "cyanLight" },
    "syntaxOperator": { "dark": "mutedDark", "light": "mutedLight" },
    "syntaxPunctuation": { "dark": "mutedDark", "light": "mutedLight" },
    "thinkingOpacity": 0.7
  }
}
