      "dark": "cyanDark",
      "light": "cyanLight"
    },
    "syntaxOperator": {
      "dark": "mutedDark",
      "light": "mutedLight"
    },
    "syntaxPunctuation": {
      "dark": "mutedDark",
      "light": "mutedLight"
    },
    "thinkingOpacity": 0.7
  }
