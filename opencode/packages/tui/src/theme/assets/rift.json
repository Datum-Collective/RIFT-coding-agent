      "dark": "accentDark",
      "light": "accentLight"
    },
    "markdownLinkText": {
      "dark": "accentSoftDark",
      "light": "accentSoftLight"
    },
    "markdownCode": {
      "dark": "#D6B98C",
      "light": "#8A5A1F"
    },
    "markdownBlockQuote": {
      "dark": "mutedDark",
      "light": "mutedLight"
