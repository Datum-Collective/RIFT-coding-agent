      "light": "amberLight"
    },
    "success": {
      "dark": "greenDark",
      "light": "greenLight"
    },
    "info": {
      "dark": "accentDark",
      "light": "accentLight"
    },
    "text": {
      "dark": "fgDark",
      "light": "fgLight"
    },
    "textMuted": {
      "dark": "mutedDark",
      "light": "mutedLight"
    },
    "selectedListItemText": {
      "dark": "fgDark",
      "light": "fgLight"
    },
    "background": {
      "dark": "bgDark",
      "light": "bgLight"
    },
    "backgroundPanel": {
      "dark": "panelDark",
      "light": "panelLight"
    },
    "backgroundElement": {
      "dark": "elementDark",
      "light": "elementLight"
    },
    "backgroundMenu": {
      "dark": "panelDark",
      "light": "panelLight"
    },
    "border": {
