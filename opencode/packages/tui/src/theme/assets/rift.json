    "secondary": {
      "dark": "accentSoftDark",
      "light": "accentSoftLight"
    },
    "accent": {
      "dark": "accentDark",
      "light": "accentLight"
    },
    "error": {
      "dark": "redDark",
      "light": "redLight"
