+# Last resort, for when rift could not be linked into a directory already on PATH (typical of a
+# fresh Mac or a Linux box without ~/.local/bin on PATH). Editing the shell config cannot help the
+# terminal the installer is running in, so instead of asking people to reload it, finish by opening
+# a new shell that already has rift on PATH. The same approach oh-my-zsh takes.
+#
+# It is only done when that is clearly safe and expected: an interactive terminal, not CI, a shell
+# we know how to start, and never when the user opted out with RIFT_NO_SHELL.
+open_shell_ok() {
+    [ -n "$reload_file" ] || return 1
+    [ -z "${RIFT_NO_SHELL:-}" ] || return 1
+    [ -z "${CI:-}" ] || return 1
+    [ -t 1 ] || return 1
+    # stdin is the script itself when piped from curl, so the new shell must read the terminal.
+    { : </dev/tty; } 2>/dev/null || return 1
+    [ -x "${SHELL:-}" ] || return 1
+    case $(basename "$SHELL") in
+        zsh | bash | fish) return 0 ;;
+        *) return 1 ;;
+    esac
+}
